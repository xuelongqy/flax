{
  "name": "@flax/webgpu-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js"
    },
    "./flax_modules.json": "./flax_modules.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/generated/*.js",
    "dist/generated/*.js.map",
    "dist/generated/*.d.ts",
    "dist/generated/*.d.ts.map",
    "dist/host/bootstrap.js",
    "dist/host/bootstrap.js.map",
    "dist/host/bootstrap.d.ts",
    "dist/host/bootstrap.d.ts.map",
    "flax_modules.json",
    "README.md",
    "native.json",
    "native/libflax_webgpu.dylib",
    "native/THIRD_PARTY_NOTICES.txt",
    "native/provenance.json"
  ],
  "scripts": {
    "build": "node ../tool/check_native.mjs && node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.npm.json",
    "typecheck": "tsc --project tsconfig.npm.json --noEmit && tsc --project tsconfig.test.json",
    "test": "node --import @flax/build/register-node-loader --test test/*.test.mjs",
    "prepack": "node ../tool/check_native.mjs"
  },
  "dependencies": {
    "@flax/core-runtime": "workspace:*",
    "@flax/ffi": "workspace:*",
    "@flax/core": "workspace:*"
  },
  "devDependencies": {
    "@flax/build": "workspace:*",
    "@flax/webgpu": "workspace:*",
    "@flax/canvas": "workspace:*"
  },
  "flax": {
    "native": "native.json"
  }
}
