{
  "name": "@flax/dart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Declaration-only public Dart SDK library surface for Flax.",
  "exports": {
    "./async": {
      "types": "./types/generated/libraries/async/index.d.ts"
    },
    "./async/*": {
      "types": "./types/generated/libraries/async/*.d.ts"
    },
    "./core": {
      "types": "./types/generated/libraries/core/index.d.ts"
    },
    "./core/*": {
      "types": "./types/generated/libraries/core/*.d.ts"
    },
    "./ui": {
      "types": "./types/generated/libraries/ui/index.d.ts"
    },
    "./ui/*": {
      "types": "./types/generated/libraries/ui/*.d.ts"
    },
    "./convert": {
      "types": "./types/generated/libraries/convert/index.d.ts"
    },
    "./convert/*": {
      "types": "./types/generated/libraries/convert/*.d.ts"
    },
    "./developer": {
      "types": "./types/generated/libraries/developer/index.d.ts"
    },
    "./developer/*": {
      "types": "./types/generated/libraries/developer/*.d.ts"
    },
    "./io": {
      "types": "./types/generated/libraries/io/index.d.ts"
    },
    "./io/*": {
      "types": "./types/generated/libraries/io/*.d.ts"
    },
    "./isolate": {
      "types": "./types/generated/libraries/isolate/index.d.ts"
    },
    "./isolate/*": {
      "types": "./types/generated/libraries/isolate/*.d.ts"
    }
  },
  "files": [
    "types"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flax/core": "workspace:*"
  },
  "flax": {
    "hostBindings": true
  }
}
