import 'dart:io';
import 'dart:typed_data';

import 'package:flax/runtime.dart';
import 'package:{{enginePackage}}/{{enginePackage}}.dart';

void main() {
  final runtime = {{engineClass}}.createRuntime();
  try {
    final bytes = runtime.createArrayBuffer(Uint8List.fromList([0, 255, 42]));
