      throw StateError('Unexpected microtask checkpoint');
    }
    runtime.drainMicrotasks();
    if ((runtime.getGlobal('answer') as FlaxJsNumber).value != 42) {
      throw StateError('Promise checkpoint failed');
    }
    runtime.registerHostFunction('echo', (_, args) => args.single);
    final echo = runtime.getGlobal('echo') as FlaxJsFunction;
    final object = runtime.evaluate('({})') as FlaxJsObject;
    runtime.evaluate(
      "globalThis.eval = () => { throw new Error('eval accessed'); }",
