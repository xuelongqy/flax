      throw StateError('Frozen bridge buffer transfer failed');
    }
    moved.release();
    transfer.release();
    bytes.release();
    if (copied.join(',') != '0,255,42') {
      throw StateError('Bulk byte copy failed');
    }
    final detached = runtime.evaluate(
      '(() => {const b = new ArrayBuffer(2);const v = new Uint8Array(b);b.transfer();return b.byteLength + v.byteLength;})()',
