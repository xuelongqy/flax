{
  "name": "@flax/material-ui-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generated standalone Material UI bindings for Flax.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flax_modules.json": "./flax_modules.json",
    "./dependencies/*": {
      "types": [
        "./dist/generated/dependencies/*.d.ts",
        "./dist/generated/dependencies/*/index.d.ts"
      ]
    },
    "./*": {
      "types": "./dist/generated/libraries/material/*.d.ts"
    }
  },
  "files": [
    "dist/index.*",
    "dist/generated",
    "flax_modules.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.npm.json --noEmit && tsc --project tsconfig.test.json",
    "build": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.npm.json",
    "test": "node --import @flax/build/register-node-loader --test test/*.test.mjs"
  },
  "dependencies": {
    "@flax/core": "workspace:*",
    "@flax/cupertino-ui": "workspace:*",
    "@flax/cupertino-ui-runtime": "workspace:*",
    "@flax/dart": "workspace:*",
    "@flax/flutter": "workspace:*",
    "@flax/core-runtime": "workspace:*"
  },
  "devDependencies": {
    "@flax/build": "workspace:*",
    "@flax/material-ui": "workspace:*"
  }
}
