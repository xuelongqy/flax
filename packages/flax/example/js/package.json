{
  "name": "@flax/example-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flax/core": "workspace:*",
    "@flax/flutter": "workspace:*",
    "@flax/core-runtime": "workspace:*",
    "@flax/dart": "workspace:*"
  },
  "exports": {
    "./showcase": {
      "types": "./dist/showcase.d.ts",
      "import": "./src/showcase.ts"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./src/ui.ts"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./src/fetch.ts"
    }
  }
}
