{
  "name": "@flax/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flax signals, generated Flutter bindings, and session host types.",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./bindings": {
      "types": "./dist/runtime/bindings.d.ts",
      "import": "./dist/runtime/bindings.js"
    },
    "./flutter": {
      "types": "./dist/flutter/index.d.ts",
      "import": "./dist/flutter/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    }
  },
  "files": [
    "dist/runtime",
    "dist/flutter",
    "dist/host/index.js",
    "dist/host/index.js.map",
    "dist/host/*.d.ts",
    "dist/host/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.npm.json --noEmit && tsc --project tsconfig.host.json && tsc --project tsconfig.test.json",
    "build": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.npm.json",
    "test": "node --expose-gc --test test/runtime/*.test.mjs test/flutter/*.test.mjs"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4",
    "web-streams-polyfill": "4.3.0"
  },
  "devDependencies": {
    "@exodus/bytes": "1.15.1",
    "core-js-pure": "3.50.0"
  }
}
