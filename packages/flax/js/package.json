{
  "name": "@flax/core-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flax runtime, binding transport, navigation, and session host types.",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./bindings": {
      "types": "./dist/runtime/bindings.d.ts",
      "import": "./dist/runtime/bindings.js"
    },
    "./navigation": {
      "types": "./dist/flutter/generated/libraries/navigation/index.d.ts",
      "import": "./dist/flutter/generated/libraries/navigation/index.js"
    },
    "./navigation/*": {
      "types": "./dist/flutter/generated/libraries/navigation/*.d.ts",
      "import": "./dist/flutter/generated/libraries/navigation/*.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./documents": {
      "types": "./dist/host/documents.d.ts"
    },
    "./flax_modules.json": "./flax_modules.json",
    "./assets": {
      "types": "./dist/runtime/assets.d.ts",
      "import": "./dist/runtime/assets.js"
    },
    "./host/canvas": {
      "types": "./dist/host/canvas.d.ts",
      "import": "./dist/host/canvas.js"
    },
    "./host/images": {
      "types": "./dist/host/images.d.ts",
      "import": "./dist/host/images.js"
    },
    "./host/worker": {
      "types": "./dist/host/worker.d.ts"
    }
  },
  "files": [
    "dist/runtime",
    "dist/flutter",
    "dist/dart/generated/libraries",
    "dist/host/index.js",
    "dist/host/index.js.map",
    "dist/host/*.d.ts",
    "dist/host/*.d.ts.map",
    "flax_modules.json",
    "README.md",
    "dist/host/bootstrap.js",
    "dist/host/fetch/*.d.ts",
    "dist/host/fetch/*.d.ts.map",
    "dist/host/canvas.js",
    "dist/host/canvas.js.map",
    "dist/host/canvas-dom.js",
    "dist/host/canvas-dom.js.map",
    "dist/host/images.js",
    "dist/host/images.js.map"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.npm.json --noEmit && tsc --project tsconfig.bindings.json --noEmit && tsc --project tsconfig.host.json && tsc --project tsconfig.test.json && tsc --project tsconfig.worker.json",
    "build": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.npm.json && tsc --project tsconfig.bindings.json && node ../../../tool/host_bundle.mjs --package flax",
    "test": "node --import @flax/build/register-node-loader --expose-gc --test test/runtime/*.test.mjs test/flutter/*.test.mjs test/fetch/*.test.mjs"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.5",
    "web-streams-polyfill": "4.3.0"
  },
  "devDependencies": {
    "@flax/dart": "workspace:*",
    "@exodus/bytes": "1.16.0",
    "@flax/core": "workspace:*",
    "@flax/build": "workspace:*",
    "core-js-pure": "3.51.0",
    "axios": "1.21.0"
  }
}
