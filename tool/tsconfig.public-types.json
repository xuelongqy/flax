{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../.local/public-types-build",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@flax/core/bindings": ["../packages/flax/js/src/runtime/bindings.ts"],
      "@flax/core/navigation": [
        "../packages/flax/js/src/flutter/generated/libraries/navigation/index.ts"
      ],
      "@flax/core/navigation/*": [
        "../packages/flax/js/src/flutter/generated/libraries/navigation/*"
      ],
      "@flax/core/*": ["../packages/flax/js/src/*"],
      "@flax/flutter/*": ["../packages/flax/js/src/flutter/generated/libraries/*"],
      "@flax/dart/*": ["../packages/flax/js/src/dart/generated/libraries/*"],
      "@flax/material-ui": ["../packages/flax_material_ui/js/src/index.ts"],
      "@flax/material-ui/*": [
        "../packages/flax_material_ui/js/src/generated/libraries/material/*"
      ],
      "@flax/cupertino-ui": ["../packages/flax_cupertino_ui/js/src/index.ts"],
      "@flax/cupertino-ui/*": [
        "../packages/flax_cupertino_ui/js/src/generated/libraries/cupertino/*"
      ],
      "@flax/flutter/widgets": ["../packages/flax/js/src/flutter/widgets.ts"],
      "@flax/material-ui/dependencies/*": [
        "../packages/flax_material_ui/js/src/generated/dependencies/*",
        "../packages/flax_material_ui/js/src/generated/dependencies/*/index.ts"
      ],
      "@flax/cupertino-ui/dependencies/*": [
        "../packages/flax_cupertino_ui/js/src/generated/dependencies/*",
        "../packages/flax_cupertino_ui/js/src/generated/dependencies/*/index.ts"
      ]
    }
  },
  "files": [
    "../packages/flax/js/src/flutter/widgets.ts",
    "../packages/flax/js/src/flutter/generated/libraries/foundation/index.ts",
    "../packages/flax/js/src/flutter/generated/libraries/gestures/index.ts",
    "../packages/flax/js/src/flutter/generated/libraries/scheduler/index.ts",
    "../packages/flax/js/src/flutter/generated/libraries/services/index.ts",
    "../packages/flax_material_ui/js/src/index.ts",
    "../packages/flax_cupertino_ui/js/src/index.ts",
    "../packages/flax/js/src/runtime/index.ts",
    "../packages/flax/js/src/runtime/assets.ts",
    "../packages/flax/js/src/runtime/bindings.ts",
    "../packages/flax/js/src/host/index.ts",
    "../packages/flax/js/src/host/vendor.d.ts",
    "../packages/flax/js/src/flutter/generated/libraries/navigation/index.ts",
    "../packages/flax_fetch/js/src/index.ts",
    "../packages/flax_fetch/js/src/globals.ts",
    "../packages/flax_websocket/js/src/index.ts",
    "../packages/flax_websocket/js/src/globals.ts",
    "../packages/flax_local_storage/js/src/index.ts",
    "../packages/flax_local_storage/js/src/globals.ts",
    "../packages/flax_canvas/js/src/index.ts",
    "../packages/flax_canvas/js/src/globals.ts"
  ],
  "include": [
    "../packages/flax/js/src/flutter/generated/libraries/*/index.ts",
    "../packages/flax/js/src/dart/generated/libraries/*/index.ts",
    "../packages/flax_material_ui/js/src/generated/**/*.ts",
    "../packages/flax_cupertino_ui/js/src/generated/**/*.ts"
  ]
}
