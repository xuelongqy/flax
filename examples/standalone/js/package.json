{
  "name": "@flax/example-standalone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@flax/core": "workspace:*",
    "@flax/flutter": "workspace:*",
    "@flax/material-ui": "workspace:*",
    "@flax/fetch": "workspace:*",
    "@flax/websocket": "workspace:*",
    "@flax/local-storage": "workspace:*",
    "@flax/canvas": "workspace:*",
    "@flax/core-runtime": "workspace:*",
    "@flax/fetch-runtime": "workspace:*",
    "@flax/websocket-runtime": "workspace:*",
    "@flax/local-storage-runtime": "workspace:*",
    "@flax/canvas-runtime": "workspace:*",
    "@flax/material-ui-runtime": "workspace:*"
  },
  "devDependencies": {
    "@flax/build": "workspace:*",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node tool/bundle.mjs",
    "modules": "node tool/modules.mjs",
    "modules:dev": "flax-dev --entry esm/main.js --out ../assets/flax_esm --entry-format module"
  },
  "description": "Standalone Flax application with images and JSON resources.",
  "flax": {
    "id": "main"
  }
}
