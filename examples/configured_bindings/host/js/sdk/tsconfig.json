{
  "extends": "../../bindings/js_modules.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src/generated",
    "outDir": ".build",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": ".build/tsconfig.tsbuildinfo",
    "declarationDir": "types",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
